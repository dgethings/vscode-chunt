{
  "comments": {
    "lineComment": "!",
    "blockComment": ["{#", "#}"]
  },
  "brackets": [
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*\\{%-?\\s*(if|for|block|macro|with|filter|call|raw)\\b.*-?%\\}",
      "end": "^\\s*\\{%-?\\s*(endif|endfor|endblock|endmacro|endwith|endfilter|endcall|endraw)\\b.*-?%\\}"
    }
  }
}
