{
  "name": "chunt",
  "displayName": "chunt",
  "description": "Language support for Cisco IOS Jinja2 configuration templates (.ios.j2) via the chunt language server",
  "version": "0.1.4",
  "license": "MIT",
  "icon": "images/icon.png",
  "publisher": "dgethings",
  "repository": {
    "type": "git",
    "url": "https://github.com/dgethings/vscode-chunt"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "cisco",
    "ios",
    "jinja2",
    "network",
    "networking",
    "lsp"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cisco_ios_jinja2",
        "aliases": [
          "Cisco IOS Jinja2",
          "cisco_ios_jinja2"
        ],
        "extensions": [
          ".ios.j2"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cisco_ios_jinja2",
        "scopeName": "source.ios.j2",
        "path": "./syntaxes/cisco-ios-jinja2.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "chunt",
      "properties": {
        "chunt.path": {
          "type": "string",
          "default": "",
          "description": "Path to a chunt binary to use instead of the one bundled with this extension. Useful for running a locally built server."
        },
        "chunt.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Log level passed to chunt serve via --log-level. Logs go to the 'chunt' output channel."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "lint": "eslint src",
    "test": "npm run compile-tests && npm run compile && npm run lint",
    "fetch-chunt": "bash scripts/fetch-chunt.sh"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.88.0",
    "@vscode/vsce": "4.1.0",
    "eslint": "^9.0.0",
    "ovsx": "1.3.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^6.0.0"
  }
}
